{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pro-angle-estimates",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "estimates.proangleconstructionpa.com", "custom_domain": true }],
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pro-angle-estimates-production", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "pro-angle-estimates-artifacts-production" },
    { "binding": "BACKUPS", "bucket_name": "pro-angle-estimates-backups-production" }
  ],
  "browser": { "binding": "BROWSER" },
  "secrets": { "required": ["D1_REST_API_TOKEN", "SMOKE_ACCESS_CLIENT_ID"] },
  "workflows": [{ "binding": "BACKUP_WORKFLOW", "name": "pro-angle-estimates-backup-production", "class_name": "BackupWorkflow", "schedules": ["0 6 * * *"] }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "SET_BY_TOFU_OUTPUT_OR_DASHBOARD",
    "ALLOWED_EMAIL": "proangleconstruction@gmail.com",
    "LOCAL_DEV_BYPASS": "false",
    "ACCOUNT_ID": "SET_BY_CI",
    "DATABASE_ID": "00000000-0000-0000-0000-000000000001"
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.1 } },
  "env": {
    "staging": {
      "name": "pro-angle-estimates-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "estimates-staging.proangleconstructionpa.com", "custom_domain": true }],
      "d1_databases": [{ "binding": "DB", "database_name": "pro-angle-estimates-staging", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "pro-angle-estimates-artifacts-staging" }, { "binding": "BACKUPS", "bucket_name": "pro-angle-estimates-backups-staging" }],
      "browser": { "binding": "BROWSER" },
      "secrets": { "required": ["D1_REST_API_TOKEN", "SMOKE_ACCESS_CLIENT_ID"] },
      "workflows": [{ "binding": "BACKUP_WORKFLOW", "name": "pro-angle-estimates-backup-staging", "class_name": "BackupWorkflow" }],
      "vars": { "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com", "ACCESS_AUD": "SET_BY_TOFU_OUTPUT_OR_DASHBOARD", "ALLOWED_EMAIL": "proangleconstruction@gmail.com", "LOCAL_DEV_BYPASS": "false", "ACCOUNT_ID": "SET_BY_CI", "DATABASE_ID": "00000000-0000-0000-0000-000000000002" }
    }
  }
}
